#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs the test suite with Minitest.
#
#   bin/test                        # everything under test/
#   bin/test test/pool_test.rb      # one file
#   bin/test -n /ractor/            # Minitest options pass through
require "bundler/setup"

root = File.expand_path("..", __dir__)
$LOAD_PATH.unshift(File.join(root, "lib"), File.join(root, "test"))

files, options = ARGV.partition { |arg| arg.end_with?(".rb") }
files = Dir[File.join(root, "test/*_test.rb")].sort if files.empty?
ARGV.replace(options)

files.each { |file| require File.expand_path(file) }
